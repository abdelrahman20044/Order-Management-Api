{
  "name": "order-management-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "npm test -- --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "explain": "node scripts/explain.js",
    "docs:generate": "node scripts/generate-openapi.js",
    "docs:check": "node scripts/check-openapi.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "testTimeout": 20000
  }
}
