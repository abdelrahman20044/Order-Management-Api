NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://orders:local-development-only@localhost:5432/orders
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Development seed only; set your own strong password before seeding.
SEED_PASSWORD=
# Use URL-safe characters; DATABASE_URL must use the same database password.
POSTGRES_PASSWORD=local-development-only
